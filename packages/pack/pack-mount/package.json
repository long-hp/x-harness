{
  "name": "@deepseek-ai/dsh-pack-mount",
  "description": "Composes one agent from the packs its workspace directory has turned on (ctx.packMount) for the DeepSeek Harness",
  "version": "0.1.3-alpha.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/pack/pack-mount"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/cordis-plugin-loader": "workspace:^",
    "@deepseek-ai/dsh-pack": "workspace:^",
    "@deepseek-ai/dsh-pack-binding": "workspace:^",
    "@deepseek-ai/dsh-scope": "workspace:^"
  },
  "dependencies": {},
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/cordis-plugin-loader": "workspace:^",
    "@deepseek-ai/dsh-pack": "workspace:^",
    "@deepseek-ai/dsh-pack-binding": "workspace:^",
    "@deepseek-ai/dsh-scope": "workspace:^"
  }
}
